{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  timezone: 'Asia/Tokyo',
  packageRules: [
    {
      // FontContext を共有する Blitz の parley 依存と同時に更新する。
      matchManagers: ['cargo'],
      matchDepNames: ['parley'],
      allowedVersions: '>=0.12.0 <0.13.0',
    },
    {
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      automerge: true,
    },
    {
      matchManagers: ['github-actions'],
      automerge: true,
    },
    {
      // fork の develop に載せた rev を使うので、既定のブランチの digest には替えない。
      matchDepNames: ['/^blitz-/', 'taffy'],
      matchUpdateTypes: ['digest'],
      enabled: false,
    },
  ],
}
