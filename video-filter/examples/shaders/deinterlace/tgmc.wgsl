//!PASS out
//!READS sm
// 再シャープの強さ：KTGMC（Sharpness 1.0）の 2 x (0.2 + 0.15 x TR1 + 0.25 x TR2)。
// ここは TR1、TR2 とも一段なので 1.2。強すぎると思えば下げる（0 で無し）。
// 時間方向に重ねるパス（tr2）が前の出力と比べるのは再シャープ前の値なので、
// 再シャープは見せる値にだけ掛ける。
const SHARP: f32 = 1.2;

fn sm_at(p: vec2<i32>) -> f32 {
    let size = vec2<i32>(textureDimensions(sm));
    return textureLoad(sm, clamp(p, vec2<i32>(0), size - 1), 0).r;
}

// 再シャープ：3x3 の [1 2 1] でぼかしたもの（RemoveGrain(12)）との差で立て、
// まわり 3x3 の値の幅に収める（SLMode。縁に白い輪を作らない）。
fn sharpened(p: vec2<i32>) -> f32 {
    let c = sm_at(p);
    let l = sm_at(p + vec2<i32>(-1, 0));
    let r = sm_at(p + vec2<i32>(1, 0));
    let u = sm_at(p + vec2<i32>(0, -1));
    let d = sm_at(p + vec2<i32>(0, 1));
    let ul = sm_at(p + vec2<i32>(-1, -1));
    let ur = sm_at(p + vec2<i32>(1, -1));
    let dl = sm_at(p + vec2<i32>(-1, 1));
    let dr = sm_at(p + vec2<i32>(1, 1));
    let blur = (c * 4.0 + (l + r + u + d) * 2.0 + ul + ur + dl + dr) / 16.0;
    let lo = min(min(min(c, l), min(r, u)), min(min(d, ul), min(min(ur, dl), dr)));
    let hi = max(max(max(c, l), max(r, u)), max(max(d, ul), max(max(ur, dr), dl)));
    return clamp(c + (c - blur) * SHARP, lo, hi);
}

fn plane(frame: i32, c: vec2<i32>, cr: bool) -> f32 {
    return select(zw_cb(frame, c), zw_cr(frame, c), cr);
}

// ---- KMergeStatic（Amatsukaze の KFMDeint）----
// ウィーブしたフレーム（フィールドの対を一枚に重ねたまま）で、止まっていて縞のある
// 画素は、ウィーブしたフレームが正しい（同じ時刻の二つのフィールド）。QR コードや
// テロップの細かい模様がこれで、動き補償に任せると行ごとに作り方がばらつき、
// 横縞が出る。nekopanda/AviSynthCUDAFilters の KFM/MergeStatic.cu（MIT License、
// NOTICE）の式を、八ビットの値のままコピーした。

// 縞：縦五点 |a + 4c + e - 3(b + d)| / 4（CalcCombe）。
fn combe_luma(p: vec2<i32>) -> f32 {
    let a = zw_luma(0, p + vec2<i32>(0, -2));
    let b = zw_luma(0, p + vec2<i32>(0, -1));
    let c = zw_luma(0, p);
    let d = zw_luma(0, p + vec2<i32>(0, 1));
    let e = zw_luma(0, p + vec2<i32>(0, 2));
    return abs(a + 4.0 * c + e - 3.0 * (b + d)) * 0.25;
}

fn combe_chroma(c: vec2<i32>, cr: bool) -> f32 {
    let a = plane(0, c + vec2<i32>(0, -2), cr);
    let b = plane(0, c + vec2<i32>(0, -1), cr);
    let m = plane(0, c, cr);
    let d = plane(0, c + vec2<i32>(0, 1), cr);
    let e = plane(0, c + vec2<i32>(0, 2), cr);
    return abs(a + 4.0 * m + e - 3.0 * (b + d)) * 0.25;
}

// 輝度と色差の大きいほう（MergeUVCoefs）。半透明のロゴの縁などは、
// 輝度より色差に縞が出る。
fn combe_at(p: vec2<i32>) -> f32 {
    let c = p / 2;
    return max(combe_luma(p), max(combe_chroma(c, false), combe_chroma(c, true))) * 255.0;
}

fn range4(a: f32, b: f32, c: f32, d: f32) -> f32 {
    return max(max(a, b), max(c, d)) - min(min(a, b), min(c, d));
}

// 時間の変わり方：ずらした二つのウィンドウ（-2..1 と -1..2）の、値の幅の小さいほう。
// KTemporalDiff は五枚のウィンドウを三つずらして最小を取る（n-3..n+3）が、本体が
// 持つのは前後二フレームまでなので、その中で同じ考え方に。
fn temporal_one(v0: f32, v1: f32, v2: f32, v3: f32, v4: f32) -> f32 {
    return min(range4(v0, v1, v2, v3), range4(v1, v2, v3, v4));
}

fn temporal_at(p: vec2<i32>) -> f32 {
    let c = p / 2;
    let y = temporal_one(zw_luma(-2, p), zw_luma(-1, p), zw_luma(0, p), zw_luma(1, p), zw_luma(2, p));
    let cb = temporal_one(plane(-2, c, false), plane(-1, c, false), plane(0, c, false), plane(1, c, false), plane(2, c, false));
    let cr = temporal_one(plane(-2, c, true), plane(-1, c, true), plane(0, c, true), plane(1, c, true), plane(2, c, true));
    return max(y, max(cb, cr)) * 255.0;
}

// ウィーブしたフレームを使う割合（0..1）。縞も時間の変わり方も上下一行に広げて
// から（ExtendCoefs）、coef = max(clamp(縞/30 - 1, ±0.5) + clamp(1 - 変化/15, ±0.5), 0)。
fn static_weave(p: vec2<i32>) -> f32 {
    let up = p + vec2<i32>(0, -1);
    let down = p + vec2<i32>(0, 1);
    let combe = max(max(combe_at(up), combe_at(p)), combe_at(down));
    let change = max(max(temporal_at(up), temporal_at(p)), temporal_at(down));
    let k = clamp(combe / 30.0 - 1.0, -0.5, 0.5) + clamp(1.0 - change / 15.0, -0.5, 0.5);
    return clamp(k, 0.0, 1.0);
}

@fragment
fn main(@builtin(position) where_: vec4<f32>) -> @location(0) vec4<f32> {
    let p = vec2<i32>(where_.xy);
    let v = textureLoad(sm, p, 0);
    var y = sharpened(p);
    var cb = v.g;
    var cr = v.b;
    // 止まっていて縞のある所は、ウィーブしたフレームへ（KMergeStatic）。元からある行は
    // ウィーブしたフレームと同じなので、全部の行に掛けてよい。
    let c = p / 2;
    let w = static_weave(p);
    y = mix(y, zw_luma(0, p), w);
    cb = mix(cb, zw_cb(0, c), w);
    cr = mix(cr, zw_cr(0, c), w);
    return vec4<f32>(zw_rgb(y, cb, cr), 1.0);
}
