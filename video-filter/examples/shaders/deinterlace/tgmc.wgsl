// 動き補償のデインタレース（KTGMC／QTGMC の考え方を小さくしたもの）。
// shaders のフォルダーの deinterlace/ に置き、プリセットの「デインタレース」で選ぶ。
//
// KFM（KFMDeint）のように 24p・30p・60i を切り替えるのは、本体との分担で:
//
// - 24p（テレシネ）は本体のフィールドマッチがウィーブする（設定の「逆テレシネ」を入に）。
//   ここに来るのは、本体が 60i と見たフィールドだけ。
// - 30p や止まった所は、下の動き補償がずれの無い本物の行を重ねるので、
//   ほぼウィーブしたのと同じ画像になる（フィールドごとに切り替えなくてよい）。
// - 60i の動く所は、前後のフィールドを動きに合わせてずらして重ね、
//   補間した行を上下の元の行から外れないように抑える。
//
// パスの流れ：
//   afield  「後」のフィールドの行だけを並べて読み出す
//   aedi    その欠けた行を NNEDI3 で（欠けた行だけを並べた半分の高さで）
//   cedi・bedi  今と前のフィールドの欠けた行（前の回の bob を使い回す。続いていなければ三次の補間）
//   bob     前・今・後のフィールドを、全部の行にする（KTGMC の EdiMode）
//   search  16x16 のブロックごとに、今から前・後への動きを三段探索で探す（向きごとに別の画素）
//   pack    前と後の動きを一枚にまとめる
//   final   止まっていて縞のある所（テロップ、QR コード）は、ウィーブしたフレームを
//           そのまま使う（Amatsukaze の KFMDeint が KTGMC に重ねる KMergeStatic）。
//           それ以外：元の行はそのまま（QTGMC の lossless）。無い行は、前後のフィールドが
//           合っていればその平均（止まった所はウィーブと同じで、細い横線が
//           上下に震えない）、合わなければ向きを見る補間を上下の元の行で
//           抑えたもの。色差も同じ動きで。
//
//   tr2     前の出力を動きに合わせて重ね、時間方向にもう一段なめらかにする
//           （KTGMC の TR2）。重ねる前の 3x3 の値の幅に戻す（Rep2）。
//   save    tr2 の結果を、次のフレームのために残す。
//   out     KMergeStatic をかけて RGB に。
//
// NNEDI3 の重みは bjin/mpv-prescalers（LGPL-3.0-or-later、元は tritical の
// NNEDI3）。
//
// ループと compute を使わない。D3D12 で DXC が無いと FXC がシェーダーを
// ビルドし、FXC は naga が出すループをビルドするのに何分もかかる（RTX 5060 Ti で
// 二分半たってもビルドが終わらなかった）。同じことを手で並べて書いてある。
//
// 本体の前置きが使う名前（at、clamped、params、luma_size、chroma_size、
// to_rgb、at_pair）は使わない。

//!FRAMES -2 2
//!TEXTURE bobs input.w input.h rgba16float
//!TEXTURE af input.w input.h 1 + 2 / r16float
//!TEXTURE ae input.w input.h 1 + 2 / r16float
//!TEXTURE ce input.w input.h 1 + 2 / r16float
//!TEXTURE be input.w input.h 1 + 2 / r16float
//!TEXTURE mvs input.w 15 + 16 / 2 * input.h 15 + 16 / rgba16float nearest
//!TEXTURE mv input.w 15 + 16 / input.h 15 + 16 / rgba16float
//!TEXTURE res input.w input.h rgba16float
//!TEXTURE sm input.w input.h rgba16float
//!TEXTURE hist input.w input.h rgba16float keep
//!TEXTURE bobkeep input.w input.h rgba16float keep

//!PASS afield
//!READS bobkeep
//!WRITES af
// 「後」のフィールドの行だけを並べて読み出す（k 番目がフレームの 2k + 反対の偶奇の行）。
// NNEDI3 はこれを四画素ずつ読む（zw_luma をフィールドの外で一度ずつにする）。
@fragment
fn main(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {
    let p = vec2<i32>(pos.xy);
    let other = 1 - i32(zw.first_row);
    let after = select(0, 1, zw.second == 1u);
    return vec4<f32>(zw_luma(after, vec2<i32>(p.x, 2 * p.y + other)), 0.0, 0.0, 1.0);
}

