// 横 c と c+1、フィールドの行 k と k+1 の四画素（textureGather の並びは
// (c, k+1)、(c+1, k+1)、(c+1, k)、(c, k)）。
fn quad(c: i32, k: i32) -> vec4<f32> {
    let size = vec2<f32>(textureDimensions(af));
    return textureGather(0, af, af_smp, vec2<f32>(f32(c + 1), f32(k + 1)) / size);
}

@fragment
fn main(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {
    let p = vec2<i32>(pos.xy);
    let x = p.x;
    // 補う行の上下二行ずつ：フィールドの k0..k0+3（フレームの y-3、y-1、y+1、y+3）。
    let k0 = p.y + i32(zw.first_row) - 2;
    let a0 = quad(x - 3, k0);
    let b0 = quad(x - 3, k0 + 2);
    let a1 = quad(x - 1, k0);
    let b1 = quad(x - 1, k0 + 2);
    let a2 = quad(x + 1, k0);
    let b2 = quad(x + 1, k0 + 2);
    let a3 = quad(x + 3, k0);
    let b3 = quad(x + 3, k0 + 2);
    let v = nnedi3(
        vec4<f32>(a0.w, a0.x, b0.w, b0.x), vec4<f32>(a0.z, a0.y, b0.z, b0.y),
        vec4<f32>(a1.w, a1.x, b1.w, b1.x), vec4<f32>(a1.z, a1.y, b1.z, b1.y),
        vec4<f32>(a2.w, a2.x, b2.w, b2.x), vec4<f32>(a2.z, a2.y, b2.z, b2.y),
        vec4<f32>(a3.w, a3.x, b3.w, b3.x), vec4<f32>(a3.z, a3.y, b3.z, b3.y),
    );
    return vec4<f32>(v, 0.0, 0.0, 1.0);
}

//!PASS cedi
//!READS bobkeep
//!WRITES ce
// 「今」のフィールドで欠けた行（フレームの 2j + 反対の偶奇の行）。
// 前の回の bob（bobkeep）がこのフィールドの物なら、それ（前の回の NNEDI3 の結果）を
// そのまま使う。続いていなければ、下の三次の補間で補う。
fn luma(frame: i32, x: i32, y: i32) -> f32 {
    return zw_luma(frame, vec2<i32>(x, y));
}

// 前の回の bob が使えないとき（飛ばした、ウィーブしたコマが挟まった）の補い：上下の四行
// （フレームの y-3、y-1、y+1、y+3）からの三次の補間。NNEDI3 は使わない。使えない
// フィールドは飛ばした直後だけで、そこで NNEDI3 を二回余計に掛けるとパスが重くなり、
// 遅れてさらに飛ばす（Apple M2 の deck でパスが 7 ms から 14 ms に）。
fn cubic(frame: i32, x: i32, y: i32) -> f32 {
    let v = (9.0 * (luma(frame, x, y - 1) + luma(frame, x, y + 1)) - luma(frame, x, y - 3) - luma(frame, x, y + 3)) / 16.0;
    return clamp(v, 0.0, 1.0);
}

// 前の回に作った bob（r が今、b が後）。
fn kept(x: i32, y: i32) -> vec4<f32> {
    let size = vec2<i32>(textureDimensions(bobkeep));
    return textureLoad(bobkeep, clamp(vec2<i32>(x, y), vec2<i32>(0), size - 1), 0);
}

// 前の回の bob が、このフィールドのものか：補う行の上下（元からある行）が、
// いまの本物の行と同じか。
fn same_field(frame: i32, x: i32, y: i32, up: f32, down: f32) -> bool {
    return abs(up - luma(frame, x, y - 1)) < 0.002 && abs(down - luma(frame, x, y + 1)) < 0.002;
}

@fragment
fn main(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {
    let p = vec2<i32>(pos.xy);
