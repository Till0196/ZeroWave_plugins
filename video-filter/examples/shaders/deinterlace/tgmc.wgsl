    let y = 2 * p.y + (1 - i32(zw.first_row));
    let frame = 0;
    let up = kept(x, y - 1).b;
    let down = kept(x, y + 1).b;
    if same_field(frame, x, y, up, down) {
        return vec4<f32>(kept(x, y).b, 0.0, 0.0, 1.0);
