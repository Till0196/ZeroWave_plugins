@fragment
fn main(@builtin(position) where_: vec4<f32>) -> @location(0) vec4<f32> {
    let b = vec2<i32>(where_.xy);
    let before = textureLoad(mvs, vec2<i32>(2 * b.x, b.y), 0).xy;
    let after = textureLoad(mvs, vec2<i32>(2 * b.x + 1, b.y), 0).xy;
    return vec4<f32>(before, after);
}

//!PASS final
//!READS bobs mv
//!WRITES res
// 前後のフィールドが「合っている」とみなす差。これより大きくずれていれば、
// 動き補償をあきらめて向きを見る補間に寄せる。
const AGREE: f32 = 0.06;
// 前後が合わない所で、補った行を上下の元の行の外へどれだけ出してよいか。
const SLACK: f32 = 0.02;
// 「止まっている」とみなす、元の行の一フレームでの変わり方。
const STILL: f32 = 0.03;
// 動いている所で、ウィーブした値が上下の元の行の外へ櫛の形で出るのを許す大きさ
// （上下それぞれとの差の積）。
const COMB: f32 = 0.002;

fn bobs_at(p: vec2<f32>) -> vec4<f32> {
    let size = vec2<f32>(textureDimensions(bobs));
    return textureSampleLevel(bobs, bobs_smp, (p + 0.5) / size, 0.0);
}

// ブロックの動き（前、後）。ブロックの中心の間を線形で補う（QTGMC の
// 重ねたブロックの代わり）。
fn block_motion(p: vec2<i32>) -> vec4<f32> {
    let size = vec2<f32>(textureDimensions(mv)) * 16.0;
    return textureSampleLevel(mv, mv_smp, (vec2<f32>(p) + 0.5) / size, 0.0);
}

// 動き m でずらした前後が、今のフィールドの元からある上下の行（本物）と
// どれだけずれるか。前後のその行は補った値なので多少はずれる。
fn misfit(q: vec2<f32>, m: vec4<f32>) -> f32 {
    var sum = 0.0;
    let up = vec2<f32>(0.0, -1.0);
    let down = vec2<f32>(0.0, 1.0);
    let side = vec2<f32>(1.0, 0.0);
    sum += abs(bobs_at(q + up + m.xy).g - bobs_at(q + up).r);
    sum += abs(bobs_at(q + up + m.zw).b - bobs_at(q + up).r);
    sum += abs(bobs_at(q + down + m.xy).g - bobs_at(q + down).r);
    sum += abs(bobs_at(q + down + m.zw).b - bobs_at(q + down).r);
    sum += abs(bobs_at(q + up - side + m.xy).g - bobs_at(q + up - side).r);
    sum += abs(bobs_at(q + down + side + m.zw).b - bobs_at(q + down + side).r);
    return sum;
}

// その画素の動き：動き無しと、ブロックの動きのうち、今のフィールドの
// 元の行によく合うほう。流れる背景の上で止まっているテロップは、ブロックの
// 動きでずらすと崩れる（前後どうしは同じだけずれるので「合って」見える）。
fn motion(p: vec2<i32>) -> vec4<f32> {
    let q = vec2<f32>(p);
    let moving = block_motion(p);
    let still = vec4<f32>(0.0);
    // 同じくらいなら動き無し（止まっているものを動かさない）。
    if misfit(q, still) <= misfit(q, moving) * 1.1 + 0.01 {
        return still;
    }
    return moving;
}

// 動きに合わせてずらした、前（g）と後（b）のフィールド。
fn before_at(q: vec2<f32>, m: vec4<f32>) -> f32 {
    return bobs_at(q + m.xy).g;
}

fn after_at(q: vec2<f32>, m: vec4<f32>) -> f32 {
    return bobs_at(q + m.zw).b;
}

// 前と後のフィールドがどれだけ合っているか（0..1）。両方とも、補う行を
// 本物の行として持っている（反対の偶奇のフィールド）ので、止まった所や
// うまく動きを合わせられた所では、ほぼ同じ値になる。左右三点で見る。
//
// 今の補った画像とは比べない：一画素の横線は補った行には現れないので、
// 比べると本物の線を持つ前後のほうを「合わない」と捨て、線が一フィールド
// おきに消えて上下に震える（ジリジリ、ラインフリッカー）。
fn agreement(p: vec2<i32>, m: vec4<f32>) -> f32 {
    let q = vec2<f32>(p);
    let l = q - vec2<f32>(1.0, 0.0);
    let r = q + vec2<f32>(1.0, 0.0);
    let diff = abs(before_at(l, m) - after_at(l, m))
        + abs(before_at(q, m) - after_at(q, m))
        + abs(before_at(r, m) - after_at(r, m));
    let w = clamp(1.0 - diff / 3.0 / AGREE, 0.0, 1.0);
    return w * w;
}

// 本当に止まっているか（0..1）：元からある上下の行が、一フレーム前の同じ
// 偶奇の行（同じ行を本物として持つ）と変わっていないか。KFM が静止の部分を
// ウィーブと同じ見方で、止まっていれば細い横線も前後の本物の行をそのまま使う。
fn stillness(p: vec2<i32>) -> f32 {
    let u = p + vec2<i32>(0, -1);
    let d = p + vec2<i32>(0, 1);
    let change = abs(zw_luma(0, u) - zw_luma(-1, u)) + abs(zw_luma(0, d) - zw_luma(-1, d));
    return clamp(1.0 - change * 0.5 / STILL, 0.0, 1.0);
}

// ウィーブした値が、上下の元の行の両方より明るい（暗い）とき、その出方（0..1）。
// 動いている所でこれが大きいのは櫛。止まった所の細い横線も同じ形なので、
// 止まっていればこれでは捨てない（[`stillness`]）。
fn combing(t: f32, up: f32, down: f32) -> f32 {
    return clamp((up - t) * (down - t) / COMB, 0.0, 1.0);
}

fn plane(frame: i32, c: vec2<i32>, cr: bool) -> f32 {
    return select(zw_cb(frame, c), zw_cr(frame, c), cr);
}

// 補う行の値：前後が合っていれば前後の平均（＝ウィーブと同じ）、合わなければ
// 空間の推定を、上下の元の行の幅に抑えて。
fn blend(spatial: f32, temporal: f32, agree: f32, up: f32, down: f32) -> f32 {
    let guarded = clamp(spatial, min(up, down) - SLACK, max(up, down) + SLACK);
    return mix(guarded, temporal, agree);
}

// 色差の、無い行を補う：前後のフィールドの本物の行（動きは半分）と、
// 上下の元の行の平均を、輝度で決めた合い方で混ぜる。
fn chroma(c: vec2<i32>, own: bool, m: vec4<f32>, agree: f32, before: i32, after: i32, cr: bool) -> f32 {
    if own {
        return plane(0, c, cr);
    }
    let up = plane(0, c + vec2<i32>(0, -1), cr);
    let down = plane(0, c + vec2<i32>(0, 1), cr);
    let b = plane(before, c + vec2<i32>(round(m.xy * 0.5)), cr);
    let a = plane(after, c + vec2<i32>(round(m.zw * 0.5)), cr);
    return blend((up + down) * 0.5, (b + a) * 0.5, agree, up, down);
}

@fragment
fn main(@builtin(position) where_: vec4<f32>) -> @location(0) vec4<f32> {
    let p = vec2<i32>(where_.xy);
    let own_row = (u32(p.y) & 1u) == zw.first_row;
    let before = select(-1, 0, zw.second == 1u);
    let after = select(0, 1, zw.second == 1u);
    let m = motion(p);
    var agree = agreement(p, m);

    var y: f32;
    if own_row {
        // 元からある行はそのまま。
        y = zw_luma(0, p);
    } else {
        let q = vec2<f32>(p);
        let temporal = (before_at(q, m) + after_at(q, m)) * 0.5;
        let up = zw_luma(0, p + vec2<i32>(0, -1));
        let down = zw_luma(0, p + vec2<i32>(0, 1));
        // 動いている所で櫛になるなら、前後の平均を信じない。
        agree *= mix(1.0 - combing(temporal, up, down), 1.0, stillness(p));
        y = blend(bobs_at(q).r, temporal, agree, up, down);
    }

    // 色差（4:2:0、インタレースなので色差の行も一行おきにフィールドを持つ）。
    let c = p / 2;
    let own_chroma = (u32(c.y) & 1u) == zw.first_row;
    var cb = chroma(c, own_chroma, m, agree, before, after, false);
    var cr = chroma(c, own_chroma, m, agree, before, after, true);

    return vec4<f32>(y, cb, cr, 1.0);
}

//!PASS tr2
//!READS res hist mv
//!WRITES sm
// 前の出力との差の閾値（八ビット、一画素あたり）：KTGMC の ThSAD2=256 を 8x8 で割ったもの。
const TH_SAD2: f32 = 4.0;


fn res_at(p: vec2<i32>) -> vec4<f32> {
    let size = vec2<i32>(textureDimensions(res));
    return textureLoad(res, clamp(p, vec2<i32>(0), size - 1), 0);
}

fn hist_at(p: vec2<i32>) -> vec4<f32> {
    let size = vec2<i32>(textureDimensions(hist));
    return textureLoad(hist, clamp(p, vec2<i32>(0), size - 1), 0);
}

fn block_motion(p: vec2<i32>) -> vec2<f32> {
    let size = vec2<f32>(textureDimensions(mv)) * 16.0;
    return textureSampleLevel(mv, mv_smp, (vec2<f32>(p) + 0.5) / size, 0.0).xy;
}

// まわり 3x3 で、今の結果と、v だけずらした前の出力の差（八ビット）。
fn diff3(p: vec2<i32>, v: vec2<i32>) -> f32 {
    var sum = abs(res_at(p + vec2<i32>(-1, -1)).r - hist_at(p + v + vec2<i32>(-1, -1)).r);
    sum += abs(res_at(p + vec2<i32>(0, -1)).r - hist_at(p + v + vec2<i32>(0, -1)).r);
    sum += abs(res_at(p + vec2<i32>(1, -1)).r - hist_at(p + v + vec2<i32>(1, -1)).r);
    sum += abs(res_at(p + vec2<i32>(-1, 0)).r - hist_at(p + v + vec2<i32>(-1, 0)).r);
    sum += abs(res_at(p).r - hist_at(p + v).r);
    sum += abs(res_at(p + vec2<i32>(1, 0)).r - hist_at(p + v + vec2<i32>(1, 0)).r);
    sum += abs(res_at(p + vec2<i32>(-1, 1)).r - hist_at(p + v + vec2<i32>(-1, 1)).r);
    sum += abs(res_at(p + vec2<i32>(0, 1)).r - hist_at(p + v + vec2<i32>(0, 1)).r);
    sum += abs(res_at(p + vec2<i32>(1, 1)).r - hist_at(p + v + vec2<i32>(1, 1)).r);
    return sum / 9.0 * 255.0;
}

fn min3x3(p: vec2<i32>) -> vec3<f32> {
    var lo = res_at(p).rgb;
    lo = min(lo, res_at(p + vec2<i32>(-1, -1)).rgb);
    lo = min(lo, res_at(p + vec2<i32>(0, -1)).rgb);
    lo = min(lo, res_at(p + vec2<i32>(1, -1)).rgb);
    lo = min(lo, res_at(p + vec2<i32>(-1, 0)).rgb);
    lo = min(lo, res_at(p + vec2<i32>(1, 0)).rgb);
    lo = min(lo, res_at(p + vec2<i32>(-1, 1)).rgb);
    lo = min(lo, res_at(p + vec2<i32>(0, 1)).rgb);
    lo = min(lo, res_at(p + vec2<i32>(1, 1)).rgb);
    return lo;
}

fn max3x3(p: vec2<i32>) -> vec3<f32> {
    var hi = res_at(p).rgb;
    hi = max(hi, res_at(p + vec2<i32>(-1, -1)).rgb);
    hi = max(hi, res_at(p + vec2<i32>(0, -1)).rgb);
    hi = max(hi, res_at(p + vec2<i32>(1, -1)).rgb);
    hi = max(hi, res_at(p + vec2<i32>(-1, 0)).rgb);
    hi = max(hi, res_at(p + vec2<i32>(1, 0)).rgb);
    hi = max(hi, res_at(p + vec2<i32>(-1, 1)).rgb);
    hi = max(hi, res_at(p + vec2<i32>(0, 1)).rgb);
    hi = max(hi, res_at(p + vec2<i32>(1, 1)).rgb);
    return hi;
}

@fragment
fn main(@builtin(position) where_: vec4<f32>) -> @location(0) vec4<f32> {
    let p = vec2<i32>(where_.xy);
    let lo = min3x3(p);
    let hi = max3x3(p);
    let cur = res_at(p);
    // 前の出力（半フレーム前）への動き：止まったままか、ブロックの前への動き。
    let moving = vec2<i32>(round(block_motion(p)));
    let d_still = diff3(p, vec2<i32>(0));
    let d_moving = diff3(p, moving);
    var v = moving;
    var d = d_moving;
    if d_still <= d_moving * 1.1 + 0.5 {
        v = vec2<i32>(0);
        d = d_still;
    }
    // MDegrain の重み、中心は二倍（binomial）。前のフレームは一枚だけ。
    let t = TH_SAD2 * TH_SAD2;
    let w = max(t - d * d, 0.0) / (t + d * d);
    let prev = hist_at(p + v);
    // 色差は動きが半分（4:2:0）なので、前の出力の同じ所を同じ動きで読む
    // （hist は全部の画素で持つ）。
    let blended = (2.0 * cur.rgb + w * prev.rgb) / (2.0 + w);
    // Rep2：重ねる前の 3x3 の値の幅へ。
    let y = clamp(blended, lo, hi);
    return vec4<f32>(y, 1.0);
}

//!PASS save
//!READS sm
//!WRITES hist
@fragment
fn main(@builtin(position) where_: vec4<f32>) -> @location(0) vec4<f32> {
    return textureLoad(sm, vec2<i32>(where_.xy), 0);
}

//!PASS savebob
//!READS bobs
//!WRITES bobkeep
@fragment
fn main(@builtin(position) where_: vec4<f32>) -> @location(0) vec4<f32> {
    return textureLoad(bobs, vec2<i32>(where_.xy), 0);
