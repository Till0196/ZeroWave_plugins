@fragment
fn main(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {
    let p = vec2<i32>(pos.xy);
    let x = p.x;
    let y = p.y;
    let own = zw.first_row;
    let mine = (u32(y) & 1u) == own;
    // 時間で一つ前と一つ後のフィールド（反対の偶奇）が、どのフレームにあるか。
    let before = select(-1, 0, zw.second == 1u);
    let after = select(0, 1, zw.second == 1u);
    // 欠けた行は、欠けた行だけを並べたパスの物（aedi・cedi・bedi）。行 y はその y / 2。
    let j = y / 2;
    var cur: f32;
    var bef: f32;
    var aft: f32;
    if mine {
        cur = luma(0, x, y);
        bef = textureLoad(be, vec2<i32>(x, j), 0).r;
        aft = textureLoad(ae, vec2<i32>(x, j), 0).r;
    } else {
        cur = textureLoad(ce, vec2<i32>(x, j), 0).r;
        bef = luma(before, x, y);
        aft = luma(after, x, y);
    }
    return vec4<f32>(cur, bef, aft, 1.0);
}

//!PASS search
//!READS bobs
//!WRITES mvs
// 一つの画素が一つのブロック（16x16）。三段探索（幅 8、4、2、1 で、まわり八つを
// 試して良い方へ動く）で ±15 画素まで。動きの大きさにかけるペナルティで、同じくらい
// 合うなら小さい動きを選ぶ。
const PENALTY: f32 = 0.002;

fn texel(p: vec2<i32>) -> vec4<f32> {
    let size = vec2<i32>(textureDimensions(bobs));
    return textureLoad(bobs, clamp(p, vec2<i32>(0), size - 1), 0);
}

// 今のフィールドの側の 16 点（候補の動きによらないので、ブロックごとに一度だけ読む）。
struct Centre {
    a: vec4<f32>,
    b: vec4<f32>,
    c: vec4<f32>,
    d: vec4<f32>,
}

fn centre(base: vec2<i32>) -> Centre {
    let a = vec4<f32>(texel(base + vec2<i32>(1, 1)).r, texel(base + vec2<i32>(5, 1)).r, texel(base + vec2<i32>(9, 1)).r, texel(base + vec2<i32>(13, 1)).r);
    let b = vec4<f32>(texel(base + vec2<i32>(3, 5)).r, texel(base + vec2<i32>(7, 5)).r, texel(base + vec2<i32>(11, 5)).r, texel(base + vec2<i32>(15, 5)).r);
    let c = vec4<f32>(texel(base + vec2<i32>(1, 9)).r, texel(base + vec2<i32>(5, 9)).r, texel(base + vec2<i32>(9, 9)).r, texel(base + vec2<i32>(13, 9)).r);
    let d = vec4<f32>(texel(base + vec2<i32>(3, 13)).r, texel(base + vec2<i32>(7, 13)).r, texel(base + vec2<i32>(11, 13)).r, texel(base + vec2<i32>(15, 13)).r);
    return Centre(a, b, c, d);
}

fn one(base: vec2<i32>, v: vec2<i32>, q: vec2<i32>, here: f32, which: i32) -> f32 {
    let other = texel(base + q + v);
    return abs(here - select(other.b, other.g, which == 1));
}

// ブロックの差：16x16 のうち 16 点（四画素おき、行ごとにずらして）。
fn sad(base: vec2<i32>, v: vec2<i32>, k: Centre, which: i32) -> f32 {
    var sum = one(base, v, vec2<i32>(1, 1), k.a.x, which);
    sum += one(base, v, vec2<i32>(5, 1), k.a.y, which);
    sum += one(base, v, vec2<i32>(9, 1), k.a.z, which);
    sum += one(base, v, vec2<i32>(13, 1), k.a.w, which);
    sum += one(base, v, vec2<i32>(3, 5), k.b.x, which);
    sum += one(base, v, vec2<i32>(7, 5), k.b.y, which);
    sum += one(base, v, vec2<i32>(11, 5), k.b.z, which);
    sum += one(base, v, vec2<i32>(15, 5), k.b.w, which);
    sum += one(base, v, vec2<i32>(1, 9), k.c.x, which);
    sum += one(base, v, vec2<i32>(5, 9), k.c.y, which);
    sum += one(base, v, vec2<i32>(9, 9), k.c.z, which);
    sum += one(base, v, vec2<i32>(13, 9), k.c.w, which);
    sum += one(base, v, vec2<i32>(3, 13), k.d.x, which);
    sum += one(base, v, vec2<i32>(7, 13), k.d.y, which);
    sum += one(base, v, vec2<i32>(11, 13), k.d.z, which);
    sum += one(base, v, vec2<i32>(15, 13), k.d.w, which);
    return sum / 16.0 + PENALTY * f32(abs(v.x) + abs(v.y));
}

// いまの良い所（xy）と差（z）から、幅 s のまわり八つを試して良い方へ。
fn step(base: vec2<i32>, best: vec3<f32>, s: i32, k: Centre, which: i32) -> vec3<f32> {
    let c = vec2<i32>(best.xy);
    var out = best;
    let v0 = c + vec2<i32>(-s, -s);
    let e0 = sad(base, v0, k, which);
    if e0 < out.z { out = vec3<f32>(vec2<f32>(v0), e0); }
    let v1 = c + vec2<i32>(0, -s);
    let e1 = sad(base, v1, k, which);
    if e1 < out.z { out = vec3<f32>(vec2<f32>(v1), e1); }
    let v2 = c + vec2<i32>(s, -s);
    let e2 = sad(base, v2, k, which);
    if e2 < out.z { out = vec3<f32>(vec2<f32>(v2), e2); }
    let v3 = c + vec2<i32>(-s, 0);
    let e3 = sad(base, v3, k, which);
    if e3 < out.z { out = vec3<f32>(vec2<f32>(v3), e3); }
    let v4 = c + vec2<i32>(s, 0);
    let e4 = sad(base, v4, k, which);
    if e4 < out.z { out = vec3<f32>(vec2<f32>(v4), e4); }
    let v5 = c + vec2<i32>(-s, s);
    let e5 = sad(base, v5, k, which);
    if e5 < out.z { out = vec3<f32>(vec2<f32>(v5), e5); }
    let v6 = c + vec2<i32>(0, s);
    let e6 = sad(base, v6, k, which);
    if e6 < out.z { out = vec3<f32>(vec2<f32>(v6), e6); }
    let v7 = c + vec2<i32>(s, s);
    let e7 = sad(base, v7, k, which);
    if e7 < out.z { out = vec3<f32>(vec2<f32>(v7), e7); }
    return out;
}

fn find(base: vec2<i32>, which: i32) -> vec2<f32> {
    let k = centre(base);
    // 止まったままを少し優先して始める。
    var best = vec3<f32>(0.0, 0.0, sad(base, vec2<i32>(0), k, which) - PENALTY);
    best = step(base, best, 8, k, which);
    best = step(base, best, 4, k, which);
    best = step(base, best, 2, k, which);
    best = step(base, best, 1, k, which);
    return best.xy;
}

@fragment
fn main(@builtin(position) where_: vec4<f32>) -> @location(0) vec4<f32> {
    let cell = vec2<i32>(where_.xy);
    let base = vec2<i32>(cell.x / 2, cell.y) * 16;
    return vec4<f32>(find(base, 1 + cell.x % 2), 0.0, 1.0);
}

